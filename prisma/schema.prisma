generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("DRIVER") // ADMIN, DRIVER
  driverId  String?  @unique // If role is DRIVER, link to Driver profile
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver    Driver?  @relation(fields: [driverId], references: [id])
}

model Driver {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  phone             String?
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, VACATION
  licenseExpiry     DateTime?
  cqcExpiry         DateTime?
  tachographExpiry  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User?
  trips             Trip[]
}

model Vehicle {
  id                String   @id @default(cuid())
  plate             String   @unique
  model             String?
  type              String   @default("TRUCK") // TRUCK, TRAILER
  status            String   @default("AVAILABLE") // AVAILABLE, MAINTENANCE, ON_TRIP
  insuranceExpiry   DateTime?
  revisionExpiry    DateTime?
  tachographExpiry  DateTime?
  currentKm         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trips             Trip[]
  maintenances      Maintenance[]
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  vatNumber   String?
  type        String // FUEL, WORKSHOP, HIGHWAY, OTHER
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  maintenances Maintenance[]
  documents    Document[]
}

model Order {
  id                String   @id @default(cuid())
  clientName        String
  cargoDescription  String
  weight            Float?
  pickupAddress     String
  deliveryAddress   String
  price             Float?
  status            String   @default("RECEIVED") // RECEIVED, ASSIGNED, IN_TRANSIT, COMPLETED, INVOICED
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip              Trip?
  documents         Document[]
}

model Trip {
  id                String   @id @default(cuid())
  orderId           String   @unique
  driverId          String
  vehicleId         String
  
  // Advanced Logistics
  emptyKm           Int      @default(0)
  loadedKm          Int      @default(0)
  
  scheduledDeparture DateTime?
  actualDeparture    DateTime?
  actualArrival      DateTime?
  
  status            String   @default("PLANNED") // PLANNED, DISPATCHED, LOADING, IN_TRANSIT, UNLOADING, COMPLETED
  expenses          Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order             Order    @relation(fields: [orderId], references: [id])
  driver            Driver   @relation(fields: [driverId], references: [id])
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
  events            TripEvent[]
  documents         Document[]
}

model TripEvent {
  id          String   @id @default(cuid())
  tripId      String
  eventType   String // DEPARTURE, ARRIVAL_LOAD, END_LOAD, ARRIVAL_UNLOAD, END_UNLOAD
  timestamp   DateTime @default(now())
  location    String? // Optional GPS coordinates or address
  note        String?

  trip        Trip     @relation(fields: [tripId], references: [id])
}

model Maintenance {
  id                String   @id @default(cuid())
  vehicleId         String
  supplierId        String?
  description       String
  cost              Float
  date              DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
}

model Document {
  id          String   @id @default(cuid())
  url         String   // Vercel Blob URL
  type        String   // INVOICE_IN, INVOICE_OUT, DDT, FUEL_RECEIPT
  title       String?
  orderId     String?
  tripId      String?
  supplierId  String?
  createdAt   DateTime @default(now())
  
  order       Order?    @relation(fields: [orderId], references: [id])
  trip        Trip?     @relation(fields: [tripId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
}
