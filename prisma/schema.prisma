// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Driver {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  phone             String?
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, VACATION
  licenseExpiry     DateTime?
  cqcExpiry         DateTime?
  tachographExpiry  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trips             Trip[]
}

model Vehicle {
  id                String   @id @default(cuid())
  plate             String   @unique
  model             String?
  type              String   @default("TRUCK") // TRUCK, TRAILER
  status            String   @default("AVAILABLE") // AVAILABLE, MAINTENANCE, ON_TRIP
  insuranceExpiry   DateTime?
  revisionExpiry    DateTime?
  tachographExpiry  DateTime?
  currentKm         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trips             Trip[]
  maintenances      Maintenance[]
}

model Order {
  id                String   @id @default(cuid())
  clientName        String
  cargoDescription  String
  weight            Float?
  pickupAddress     String
  deliveryAddress   String
  price             Float?
  status            String   @default("RECEIVED") // RECEIVED, ASSIGNED, IN_TRANSIT, COMPLETED, INVOICED
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip              Trip?
}

model Trip {
  id                String   @id @default(cuid())
  orderId           String   @unique
  driverId          String
  vehicleId         String
  scheduledDeparture DateTime?
  actualDeparture   DateTime?
  actualArrival     DateTime?
  status            String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  expenses          Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order             Order    @relation(fields: [orderId], references: [id])
  driver            Driver   @relation(fields: [driverId], references: [id])
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Maintenance {
  id                String   @id @default(cuid())
  vehicleId         String
  description       String
  cost              Float
  date              DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
}
